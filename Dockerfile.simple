# Model Router - simplified Docker for low-memory environments
# Build locally first (npm run build), then use this Dockerfile

FROM node:22-alpine

WORKDIR /app

# Install only production dependencies
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy pre-built dist
COPY dist ./dist

# Runtime configuration
ENV NODE_ENV=production
ENV PORT=3003
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info
ENV DEFAULT_TIER=standard
ENV DEFAULT_OUTPUT_RATIO=0.33

# Data directory for SQLite
RUN mkdir -p /data
ENV DB_PATH=/data/modelrouter.db

EXPOSE 3003

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3003/health || exit 1

CMD ["node", "dist/index.js"]
