{
  "name": "modelrouter",
  "version": "0.1.0",
  "description": "AI model routing proxy — tier-based intelligent routing across providers",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "keygen": "tsx src/cli/keygen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "check-prices": "tsx src/scripts/check-prices.ts",
    "predeploy": "npm run build && npm test && npm run check-prices"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "better-sqlite3": "^11.8.0",
    "google-auth-library": "^10.6.1",
    "hono": "^4.7.0",
    "nanoid": "^5.1.0",
    "openai": "^4.80.0",
    "resend": "^6.9.3",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
